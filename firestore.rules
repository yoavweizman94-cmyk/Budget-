rules_version = '2';

// כללי האבטחה של התקציב המשפחתי.
// רק מי שרשום כחבר במשק הבית יכול לקרוא או לשנות את הנתונים שלו.
// הצטרפות למשק בית אפשרית רק למי שמחזיק בקישור ההזמנה (מזהה אקראי וארוך),
// ורק כל עוד "הצטרפות דרך הקישור" פתוחה בהגדרות.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // לאיזה משק בית המשתמש שייך — כל משתמש רואה ומעדכן רק את הרשומה של עצמו
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];

      // חבר קיים: מותר לעדכן הכול חוץ מרשימת החברים
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;

      // הצטרפות: משתמש חדש מוסיף רק את עצמו (ואת השם שלו), עד 6 חברים
      allow update: if signedIn()
        && resource.data.joinOpen == true
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.size() <= 6
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid]);

      allow delete: if false;

      match /recurring/{id} {
        allow read, write: if isMember(hid);
      }

      match /expenses/{id} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
